# Auto Video Gen - environment configuration
# Copy to .env.local. Never commit real API keys.

# TTS provider: edge-tts | lucylab | elevenlabs | vbee
TTS_PROVIDER=edge-tts

# Edge TTS - free, no API key required
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%

# LucyLab - required only when TTS_PROVIDER=lucylab
VIETNAMESE_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
VIETNAMESE_VOICEID=22charvoiceiduuidhere
LUCYLAB_ENDPOINT=https://api.lucylab.io/json-rpc
LUCYLAB_POLL_INTERVAL_MS=2000
LUCYLAB_POLL_TIMEOUT_MS=120000

# ElevenLabs - required only when TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1

# Vbee - required only when TTS_PROVIDER=vbee
VBEE_APP_ID=your_app_id
VBEE_ACCESS_TOKEN=your_access_token
VBEE_VOICE_CODE=n_hanoi_male_protrainer_education_vc
VBEE_SPEED_RATE=1.0
VBEE_ENDPOINT=https://vbee.vn/api/v1
VBEE_POLL_INTERVAL_MS=2000
VBEE_POLL_TIMEOUT_MS=60000

TTS_CONCURRENCY=1

# product is the default for real product demos.
# dark-neon and light-pro are retained only for legacy scripts.
VIDEO_THEME=product
