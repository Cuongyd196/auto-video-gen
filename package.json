{
  "name": "auto-news-video",
  "version": "2.0.0",
  "description": "TTS-first 9:16 product video generator for TikTok, YouTube Shorts and Facebook Reels",
  "main": "src/cli.ts",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "pipeline": "tsx src/cli.ts",
    "rerender": "tsx rerender.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "sfx:download": "tsx scripts/download-sfx.ts",
    "sfx:filter": "tsx scripts/filter-sfx.ts"
  },
  "keywords": [
    "video",
    "tts",
    "product-video",
    "vietnamese",
    "tiktok",
    "reels",
    "shorts",
    "hyperframes",
    "codex",
    "ffmpeg"
  ],
  "author": "namnth2000",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/namnth2000/auto-video-gen.git"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "edge-tts-universal": "^1.4.0",
    "hyperframes": "^0.4.34",
    "p-limit": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "nock": "^14.0.13",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
